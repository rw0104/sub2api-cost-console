# Build from the repository root:
# docker build -f deploy/Dockerfile.plugin-sandbox -t sub2api-plugin-sandbox:1 .
FROM golang:1.27.4-alpine@sha256:0a5f7fe796599ff487605987432e7619ae45beeb2fba4c2ce0b907879932aebf AS build
WORKDIR /src
COPY backend/cmd/plugin-sandbox/main.go ./main.go
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /sandbox main.go

FROM scratch
LABEL org.sub2api.plugin-sandbox.api="1"
COPY --from=build /sandbox /sub2api-plugin-sandbox
ENTRYPOINT ["/sub2api-plugin-sandbox", "supervise"]
